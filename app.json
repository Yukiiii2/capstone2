{
  "expo": {
    "name": "Voclaria",
    "slug": "Voclaria",
    "scheme": "Voclaria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Speaksy.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "updates": {
      "url": "https://u.expo.dev/c4cef469-b796-4bd9-874c-163e352fc63f",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": "1.0.0",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.voclaria",
      "infoPlist": {
        "CFBundleDisplayName": "Voclaria",
        "NSCameraUsageDescription": "This app uses the camera to record video for your practice sessions.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record audio during video recording.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save videos to your photo library.",
        "NSPhotoLibraryUsageDescription": "This app needs permission to access your photo library to save videos."
      }
    },
    "android": {
      "package": "com.yourcompany.voclaria",
      "icon": "./assets/Speaksy.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Speaksy.png",
        "backgroundColor": "#1A1F2E"
      },
      "navigationBar": {
        "backgroundColor": "#1A1F2E",
        "barStyle": "light"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "This app uses the camera to record video for your practice sessions.",
          "microphonePermissionText": "This app needs access to your microphone to record audio during video recording."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c4cef469-b796-4bd9-874c-163e352fc63f"
      },
      "router": {}
    }
  }
}

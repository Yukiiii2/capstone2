{
  "expo": {
    "name": "capstone2",
    "slug": "capstone2",
    "scheme": "capstone2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.capstone2",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access so you can record your presentation.",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record audio during video recording.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save videos to your photo library.",
        "NSPhotoLibraryUsageDescription": "This app needs permission to access your photo library to save videos."
     
      }
    },
    "android": {
      "package": "com.yourcompany.capstone2",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1F2E"
      },
      "navigationBar": {
        "backgroundColor": "#1A1F2E",
        "barStyle": "light"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_VIDEO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_MICROPHONE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "windowSoftInputMode": "adjustResize"
    },
    "web": { "favicon": "./assets/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "react-native-vision-camera",
        {
          "enableMicrophonePermission": true,
          "cameraPermissionText": "We need camera access so you can record your presentation.",
          "microphonePermissionText": "We need microphone access to capture your voice."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ${PRODUCT_NAME} to access your photos.",
          "savePhotosPermission": "Allow ${PRODUCT_NAME} to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": { "projectId": "11dc4851-7555-4362-97bc-956807c92d3f" }
    }
  }}
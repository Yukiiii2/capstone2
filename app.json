{
  "expo": {
    "name": "capstone2",
    "slug": "capstone2",
    "scheme": "capstone2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1F2E"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.yourcompany.capstone2"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-audio",
      "expo-secure-store",
      "react-native-vision-camera",
      ["expo-navigation-bar", { "backgroundColor": "#1A1F2E", "barStyle": "light" }],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "kotlinVersion": "2.0.21",
            "kspVersion": "2.0.21-1.0.28",
            "gradleProperties": {
              "FFMPEG_KIT_PACKAGE": "https",
              "FFMPEG_KIT_VERSION": "6.0-3.LTS"
            }
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": { "projectId": "84e12547-d24a-49fc-9873-4638f3046c14" }
    }
  }
}

{
  "expo": {
    "name": "capstone2",
    "slug": "capstone2",
    "scheme": "capstone2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "platforms": ["android"],

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "android": {
      "package": "com.yourcompany.capstone2",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1F2E"
      },
      "navigationBar": {
        "backgroundColor": "#1A1F2E",
        "barStyle": "light"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_VIDEO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_CAMERA",
        "FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "windowSoftInputMode": "adjustResize",
      "jsEngine": "hermes"
    },

    "experiments": {
      "reactNativeEngine": "hermes",
      "baseFabric": false
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "react-native-vision-camera",
        {
          "enableMicrophonePermission": true,
          "cameraPermissionText": "We need camera access so you can record your presentation.",
          "microphonePermissionText": "We need microphone access to capture your voice."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow ${PRODUCT_NAME} to access your photos.",
          "savePhotosPermission": "Allow ${PRODUCT_NAME} to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],

    "extra": {
      "router": {}
    }
  }
}
